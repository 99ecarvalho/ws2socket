PROJECT_NAME           = "ws2socket"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "WebSocket to TCP Socket Proxy"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@

INPUT                  = @DOXYGEN_INPUT_DIR@/include @DOXYGEN_INPUT_DIR@/src
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.c
EXCLUDE_PATTERNS       = */test/*

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

HTML_OUTPUT            = html
HTML_STYLESHEET        = 

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_PACKAGE        = NO

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = 

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_EMPTY      = YES

OPTIMIZE_OUTPUT_FOR_C  = YES
OPTIMIZE_FOR_LARGE_PROJECTS = NO

TYPEDEF_HIDES_STRUCT   = NO
SYMBOL_CACHE_SIZE      = 9

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = "__cplusplus"

SEARCH_INCLUDES        = YES
INCLUDE_PATH           = 
INCLUDE_FILE_PATTERNS  = *.h

VERBATIM_HEADERS       = YES

ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 5

HTML_DYNAMIC_SECTIONS  = NO
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES

TREEVIEW_WIDTH         = 250

ENUM_VALUES_PER_LINE   = 4

DOTFILE_DIRS           =
MSCFILE_DIRS           =
DIAFILE_DIRS           =

HAVE_DOT               = NO

CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

DOT_IMAGE_FORMAT       = png
DOT_PATH               = 
DOTFILE_DIRS           = 
DOT_GRAPH_MAX_NODES    = 50
DOT_TRANSPARENT        = NO
DOT_MULTIPLE_TARGETS   = NO
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

SEARCHENGINE           = NO
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO
